generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  name          String
  isActive      Boolean        @default(true) @map("is_active")
  role          Role           @relation(fields: [roleId], references: [id])
  roleId        String         @map("role_id")
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // ADMIN | MANAGER | WAREHOUSE | SALES
  description String?
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique // เช่น product.read, stock.receive, doc.approve
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role         Role       @relation(fields: [roleId], references: [id])
  roleId       String     @map("role_id")
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId String     @map("permission_id")

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------- Master Data ----------

enum TrackingType {
  NONE // ตัดสต๊อกตามจำนวนอย่างเดียว (น็อต, ท่อ)
  SERIAL // ตามตัวรายเครื่อง (แอร์, ตู้เย็น, ปั๊มน้ำ)
  LOT // ตาม lot + วันหมดอายุ (ปูน, สี)
}

enum CostingMethod {
  AVG
  FIFO
}

enum PartnerType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum PriceLevel {
  RETAIL // ลูกค้าปลีกหน้าร้าน
  CONTRACTOR // ช่างประจำ
  PROJECT // งานโครงการ
}

model Uom {
  id           String        @id @default(uuid())
  code         String        @unique // PCS, BAR, BUNDLE, M, ROLL, BAG, CAN, BOX
  name         String // ชิ้น, เส้น, มัด, เมตร, ม้วน, ถุง, กระป๋อง, ลัง
  isActive     Boolean       @default(true) @map("is_active")
  baseProducts Product[]     @relation("BaseUom")
  productUnits ProductUnit[]

  @@map("uoms")
}

model Category {
  id       String     @id @default(uuid())
  name     String     @unique
  parentId String?    @map("parent_id")
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  isActive Boolean    @default(true) @map("is_active")
  products Product[]

  @@map("categories")
}

model Warehouse {
  id       String          @id @default(uuid())
  code     String          @unique
  name     String
  isActive Boolean         @default(true) @map("is_active")
  movements StockMovement[]
  balances  StockBalance[]

  @@map("warehouses")
}

model Product {
  id              String           @id @default(uuid())
  sku             String           @unique
  name            String
  brand           String?
  model           String?
  category        Category?        @relation(fields: [categoryId], references: [id])
  categoryId      String?          @map("category_id")
  baseUom         Uom              @relation("BaseUom", fields: [baseUomId], references: [id])
  baseUomId       String           @map("base_uom_id")
  trackingType    TrackingType     @default(NONE) @map("tracking_type")
  costingMethod   CostingMethod    @default(AVG) @map("costing_method")
  warrantyMonths  Int              @default(0) @map("warranty_months")
  priceRetail     Decimal          @default(0) @map("price_retail") @db.Decimal(18, 2)
  priceContractor Decimal          @default(0) @map("price_contractor") @db.Decimal(18, 2)
  priceProject    Decimal          @default(0) @map("price_project") @db.Decimal(18, 2)
  minStock        Decimal          @default(0) @map("min_stock") @db.Decimal(18, 3)
  isActive        Boolean          @default(true) @map("is_active")
  units           ProductUnit[]
  barcodes        ProductBarcode[]
  movements       StockMovement[]
  balances        StockBalance[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([name])
  @@index([brand])
  @@map("products")
}

model ProductUnit {
  id               String           @id @default(uuid())
  product          Product          @relation(fields: [productId], references: [id])
  productId        String           @map("product_id")
  uom              Uom              @relation(fields: [uomId], references: [id])
  uomId            String           @map("uom_id")
  // 1 หน่วยนี้ = กี่หน่วยฐาน (1 มัด = 10 เส้น → factor 10)
  conversionFactor Decimal          @map("conversion_factor") @db.Decimal(18, 6)
  salePrice        Decimal?         @map("sale_price") @db.Decimal(18, 2)
  isActive         Boolean          @default(true) @map("is_active")
  barcodes         ProductBarcode[]

  @@unique([productId, uomId])
  @@map("product_units")
}

model ProductBarcode {
  id            String       @id @default(uuid())
  product       Product      @relation(fields: [productId], references: [id])
  productId     String       @map("product_id")
  // null = barcode ของหน่วยฐาน
  productUnit   ProductUnit? @relation(fields: [productUnitId], references: [id])
  productUnitId String?      @map("product_unit_id")
  barcode       String       @unique
  isInternal    Boolean      @default(false) @map("is_internal") // QR ที่ระบบ generate เอง

  @@map("product_barcodes")
}

model Partner {
  id             String      @id @default(uuid())
  code           String      @unique
  name           String
  type           PartnerType
  taxId          String?     @map("tax_id")
  phone          String?
  address        String?
  creditTermDays Int         @default(0) @map("credit_term_days")
  priceLevel     PriceLevel  @default(RETAIL) @map("price_level")
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@index([type])
  @@map("partners")
}

// ---------- Inventory Ledger (append-only — ห้าม UPDATE/DELETE เด็ดขาด) ----------

enum MovementType {
  RECEIVE
  ISSUE
  ADJUST_IN
  ADJUST_OUT
  TRANSFER_IN
  TRANSFER_OUT
  REVERSAL
}

model StockMovement {
  id           String        @id @default(uuid())
  product      Product       @relation(fields: [productId], references: [id])
  productId    String        @map("product_id")
  warehouse    Warehouse     @relation(fields: [warehouseId], references: [id])
  warehouseId  String        @map("warehouse_id")
  // signed + หน่วยฐานเสมอ: บวก = เข้า, ลบ = ออก
  qty          Decimal       @db.Decimal(18, 3)
  unitCost     Decimal       @map("unit_cost") @db.Decimal(18, 4)
  totalCost    Decimal       @map("total_cost") @db.Decimal(18, 2) // signed ตาม qty
  movementType MovementType  @map("movement_type")
  // ทุก movement ต้องอ้างเอกสาร — MANUAL/ADJUSTMENT ใช้เลขอ้างอิงที่ผู้ใช้ระบุ
  refDocType   String        @map("ref_doc_type")
  refDocId     String        @map("ref_doc_id")
  note         String?
  // กลับรายการได้ครั้งเดียว (unique) และตัว REVERSAL เองห้ามถูกกลับซ้ำ
  reversalOf   StockMovement? @relation("Reversal", fields: [reversalOfId], references: [id])
  reversalOfId String?        @unique @map("reversal_of_id")
  reversedBy   StockMovement? @relation("Reversal")
  createdAt    DateTime      @default(now()) @map("created_at")
  createdBy    String        @map("created_by")

  @@index([productId, warehouseId, createdAt])
  @@index([refDocType, refDocId])
  @@map("stock_movements")
}

// CACHE เท่านั้น — source of truth คือ SUM(stock_movements) ตรวจด้วย /inventory/reconcile
model StockBalance {
  product     Product   @relation(fields: [productId], references: [id])
  productId   String    @map("product_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  warehouseId String    @map("warehouse_id")
  qtyOnHand   Decimal   @default(0) @map("qty_on_hand") @db.Decimal(18, 3)
  avgCost     Decimal   @default(0) @map("avg_cost") @db.Decimal(18, 4)
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@id([productId, warehouseId])
  @@map("stock_balances")
}

model RefreshToken {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") // sha256 ของ token — ไม่เก็บ token ดิบ
  familyId  String    @map("family_id") // ใช้ตรวจ reuse: token เก่าถูกใช้ซ้ำ → revoke ทั้ง family
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}
