generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  name          String
  isActive      Boolean        @default(true) @map("is_active")
  role          Role           @relation(fields: [roleId], references: [id])
  roleId        String         @map("role_id")
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // ADMIN | MANAGER | WAREHOUSE | SALES
  description String?
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique // เช่น product.read, stock.receive, doc.approve
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role         Role       @relation(fields: [roleId], references: [id])
  roleId       String     @map("role_id")
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId String     @map("permission_id")

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------- Master Data ----------

enum TrackingType {
  NONE // ตัดสต๊อกตามจำนวนอย่างเดียว (น็อต, ท่อ)
  SERIAL // ตามตัวรายเครื่อง (แอร์, ตู้เย็น, ปั๊มน้ำ)
  LOT // ตาม lot + วันหมดอายุ (ปูน, สี)
}

enum CostingMethod {
  AVG
  FIFO
}

enum PartnerType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum PriceLevel {
  RETAIL // ลูกค้าปลีกหน้าร้าน
  CONTRACTOR // ช่างประจำ
  PROJECT // งานโครงการ
}

model Uom {
  id           String        @id @default(uuid())
  code         String        @unique // PCS, BAR, BUNDLE, M, ROLL, BAG, CAN, BOX
  name         String // ชิ้น, เส้น, มัด, เมตร, ม้วน, ถุง, กระป๋อง, ลัง
  isActive     Boolean       @default(true) @map("is_active")
  baseProducts Product[]     @relation("BaseUom")
  productUnits ProductUnit[]

  @@map("uoms")
}

model Category {
  id       String     @id @default(uuid())
  name     String     @unique
  parentId String?    @map("parent_id")
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  isActive Boolean    @default(true) @map("is_active")
  products Product[]

  @@map("categories")
}

model Warehouse {
  id       String          @id @default(uuid())
  code     String          @unique
  name     String
  isActive Boolean         @default(true) @map("is_active")
  movements StockMovement[]
  balances  StockBalance[]
  costLayers CostLayer[]
  serialNumbers SerialNumber[]
  salesOrders SalesOrder[]
  deliveryOrders DeliveryOrder[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts GoodsReceipt[]

  @@map("warehouses")
}

model Product {
  id              String           @id @default(uuid())
  sku             String           @unique
  name            String
  brand           String?
  model           String?
  category        Category?        @relation(fields: [categoryId], references: [id])
  categoryId      String?          @map("category_id")
  baseUom         Uom              @relation("BaseUom", fields: [baseUomId], references: [id])
  baseUomId       String           @map("base_uom_id")
  trackingType    TrackingType     @default(NONE) @map("tracking_type")
  costingMethod   CostingMethod    @default(AVG) @map("costing_method")
  warrantyMonths  Int              @default(0) @map("warranty_months")
  priceRetail     Decimal          @default(0) @map("price_retail") @db.Decimal(18, 2)
  priceContractor Decimal          @default(0) @map("price_contractor") @db.Decimal(18, 2)
  priceProject    Decimal          @default(0) @map("price_project") @db.Decimal(18, 2)
  minStock        Decimal          @default(0) @map("min_stock") @db.Decimal(18, 3)
  /// public_id ของรูปบน Cloudinary — ไฟล์จริงไม่ผ่านเซิร์ฟเวอร์เรา
  imagePublicId   String?          @map("image_public_id")
  isActive        Boolean          @default(true) @map("is_active")
  units           ProductUnit[]
  barcodes        ProductBarcode[]
  movements       StockMovement[]
  balances        StockBalance[]
  costLayers      CostLayer[]
  serialNumbers   SerialNumber[]
  lots            Lot[]
  quotationLines  QuotationLine[]
  soLines         SalesOrderLine[]
  deliveryLines   DeliveryOrderLine[]
  invoiceLines    InvoiceLine[]
  poLines         PurchaseOrderLine[]
  grLines         GoodsReceiptLine[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([name])
  @@index([brand])
  @@map("products")
}

model ProductUnit {
  id               String           @id @default(uuid())
  product          Product          @relation(fields: [productId], references: [id])
  productId        String           @map("product_id")
  uom              Uom              @relation(fields: [uomId], references: [id])
  uomId            String           @map("uom_id")
  // 1 หน่วยนี้ = กี่หน่วยฐาน (1 มัด = 10 เส้น → factor 10)
  conversionFactor Decimal          @map("conversion_factor") @db.Decimal(18, 6)
  salePrice        Decimal?         @map("sale_price") @db.Decimal(18, 2)
  isActive         Boolean          @default(true) @map("is_active")
  barcodes         ProductBarcode[]
  quotationLines   QuotationLine[]
  soLines          SalesOrderLine[]
  deliveryLines    DeliveryOrderLine[]
  invoiceLines     InvoiceLine[]
  poLines          PurchaseOrderLine[]
  grLines          GoodsReceiptLine[]

  @@unique([productId, uomId])
  @@map("product_units")
}

model ProductBarcode {
  id            String       @id @default(uuid())
  product       Product      @relation(fields: [productId], references: [id])
  productId     String       @map("product_id")
  // null = barcode ของหน่วยฐาน
  productUnit   ProductUnit? @relation(fields: [productUnitId], references: [id])
  productUnitId String?      @map("product_unit_id")
  barcode       String       @unique
  isInternal    Boolean      @default(false) @map("is_internal") // QR ที่ระบบ generate เอง

  @@map("product_barcodes")
}

model Partner {
  id             String      @id @default(uuid())
  code           String      @unique
  name           String
  type           PartnerType
  taxId          String?     @map("tax_id")
  phone          String?
  address        String?
  creditTermDays Int         @default(0) @map("credit_term_days")
  priceLevel     PriceLevel  @default(RETAIL) @map("price_level")
  isActive       Boolean     @default(true) @map("is_active")
  serialsSold    SerialNumber[]
  quotations     Quotation[]
  salesOrders    SalesOrder[]
  deliveryOrders DeliveryOrder[]
  invoices       Invoice[]
  payments       Payment[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@index([type])
  @@map("partners")
}

// ---------- Inventory Ledger (append-only — ห้าม UPDATE/DELETE เด็ดขาด) ----------

enum MovementType {
  RECEIVE
  ISSUE
  ADJUST_IN
  ADJUST_OUT
  TRANSFER_IN
  TRANSFER_OUT
  REVERSAL
}

model StockMovement {
  id           String        @id @default(uuid())
  product      Product       @relation(fields: [productId], references: [id])
  productId    String        @map("product_id")
  warehouse    Warehouse     @relation(fields: [warehouseId], references: [id])
  warehouseId  String        @map("warehouse_id")
  // signed + หน่วยฐานเสมอ: บวก = เข้า, ลบ = ออก
  qty          Decimal       @db.Decimal(18, 3)
  unitCost     Decimal       @map("unit_cost") @db.Decimal(18, 4)
  totalCost    Decimal       @map("total_cost") @db.Decimal(18, 2) // signed ตาม qty
  movementType MovementType  @map("movement_type")
  // ทุก movement ต้องอ้างเอกสาร — MANUAL/ADJUSTMENT ใช้เลขอ้างอิงที่ผู้ใช้ระบุ
  refDocType   String        @map("ref_doc_type")
  refDocId     String        @map("ref_doc_id")
  note         String?
  // สินค้า tracking_type = LOT ต้องระบุล็อตทุก movement
  lot          Lot?          @relation(fields: [lotId], references: [id])
  lotId        String?       @map("lot_id")
  // กลับรายการได้ครั้งเดียว (unique) และตัว REVERSAL เองห้ามถูกกลับซ้ำ
  reversalOf   StockMovement? @relation("Reversal", fields: [reversalOfId], references: [id])
  reversalOfId String?        @unique @map("reversal_of_id")
  reversedBy   StockMovement? @relation("Reversal")
  // FIFO: movement รับเข้าสร้าง layer ได้ 1 ก้อน / movement จ่ายออกกิน layer ได้หลายก้อน
  costLayer    CostLayer?             @relation("LayerSource")
  consumptions CostLayerConsumption[] @relation("LayerConsumer")
  serialsIn    SerialNumber[]         @relation("SerialReceive")
  serialsOut   SerialNumber[]         @relation("SerialIssue")
  createdAt    DateTime      @default(now()) @map("created_at")
  createdBy    String        @map("created_by")

  @@index([productId, warehouseId, createdAt])
  @@index([refDocType, refDocId])
  @@index([lotId, warehouseId])
  @@map("stock_movements")
}

// ---------- Serial tracking (แอร์ ตู้เย็น ปั๊มน้ำ — ตามตัวรายเครื่อง) ----------

enum SerialStatus {
  IN_STOCK // อยู่ในคลัง พร้อมขาย
  SOLD // ขายออกไปแล้ว (นับประกันจากวันขาย)
  CLAIMED // ลูกค้าส่งเคลม
  RETURNED // รับคืนเข้าคลัง
}

model SerialNumber {
  id                String        @id @default(uuid())
  product           Product       @relation(fields: [productId], references: [id])
  productId         String        @map("product_id")
  // unique ทั้งระบบ เพื่อให้หน้าเคลม "ยิง serial ปุ๊บรู้ทันที" ไม่ต้องถามรุ่นก่อน
  serial            String        @unique
  warehouse         Warehouse?    @relation(fields: [warehouseId], references: [id])
  warehouseId       String?       @map("warehouse_id")
  status            SerialStatus  @default(IN_STOCK)
  receiveMovement   StockMovement @relation("SerialReceive", fields: [receiveMovementId], references: [id])
  receiveMovementId String        @map("receive_movement_id")
  issueMovement     StockMovement? @relation("SerialIssue", fields: [issueMovementId], references: [id])
  issueMovementId   String?       @map("issue_movement_id")
  soldToPartner     Partner?      @relation(fields: [soldToPartnerId], references: [id])
  soldToPartnerId   String?       @map("sold_to_partner_id")
  soldAt            DateTime?     @map("sold_at")
  warrantyEnd       DateTime?     @map("warranty_end")
  note              String?
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([productId, status])
  @@index([warehouseId, status])
  @@index([warrantyEnd])
  @@map("serial_numbers")
}

// ---------- Lot tracking (ปูน สี เคมีภัณฑ์ — มีวันหมดอายุ จ่ายแบบ FEFO) ----------

model Lot {
  id         String          @id @default(uuid())
  product    Product         @relation(fields: [productId], references: [id])
  productId  String          @map("product_id")
  lotNo      String          @map("lot_no")
  expiryDate DateTime?       @map("expiry_date")
  receivedAt DateTime        @map("received_at")
  note       String?
  movements  StockMovement[]
  costLayers CostLayer[]
  deliveryLines DeliveryOrderLine[]
  createdAt  DateTime        @default(now()) @map("created_at")

  // ยอดคงเหลือราย lot ไม่เก็บ cache — คำนวณจาก SUM(movements) ตามหลัก ledger
  @@unique([productId, lotNo])
  @@index([productId, expiryDate])
  @@map("lots")
}

// ---------- FIFO cost layers (ใช้เฉพาะสินค้า costing_method = FIFO) ----------

model CostLayer {
  id               String                @id @default(uuid())
  product          Product               @relation(fields: [productId], references: [id])
  productId        String                @map("product_id")
  warehouse        Warehouse             @relation(fields: [warehouseId], references: [id])
  warehouseId      String                @map("warehouse_id")
  // null ได้เฉพาะ layer ยอดยกมา (isOpening) ที่ไม่ได้เกิดจากการรับเข้าใบใด
  sourceMovement   StockMovement?        @relation("LayerSource", fields: [sourceMovementId], references: [id])
  sourceMovementId String?               @unique @map("source_movement_id")
  originalQty      Decimal               @map("original_qty") @db.Decimal(18, 3)
  remainingQty     Decimal               @map("remaining_qty") @db.Decimal(18, 3)
  unitCost         Decimal               @map("unit_cost") @db.Decimal(18, 4)
  receivedAt       DateTime              @map("received_at")
  // ยอดยกมาตอนเริ่มใช้ FIFO (สลับ method จาก AVG หรือ backfill ข้อมูลเก่า)
  isOpening        Boolean               @default(false) @map("is_opening")
  note             String?
  // สินค้า LOT: ต้นทุนผูกกับล็อต — จ่ายล็อตไหนต้องกินทุนของล็อตนั้น
  // (FEFO เลือกล็อตตามวันหมดอายุ ซึ่งอาจไม่ใช่ล็อตที่รับเข้าก่อน)
  lot              Lot?                  @relation(fields: [lotId], references: [id])
  lotId            String?               @map("lot_id")
  consumptions     CostLayerConsumption[]

  // จ่ายออกเรียงตาม received_at เก่าสุดก่อน — index นี้คือหัวใจความเร็วของ FIFO
  @@index([productId, warehouseId, receivedAt])
  @@index([lotId])
  @@map("cost_layers")
}

// append-only เหมือน ledger: กลับรายการ = ลงแถวใหม่ qty ติดลบ ไม่ลบแถวเดิม
// invariant: original_qty - SUM(consumptions.qty) = remaining_qty เสมอ
model CostLayerConsumption {
  id              String        @id @default(uuid())
  layer           CostLayer     @relation(fields: [layerId], references: [id])
  layerId         String        @map("layer_id")
  issueMovement   StockMovement @relation("LayerConsumer", fields: [issueMovementId], references: [id])
  issueMovementId String        @map("issue_movement_id")
  qty             Decimal       @db.Decimal(18, 3)
  unitCost        Decimal       @map("unit_cost") @db.Decimal(18, 4)
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([issueMovementId])
  @@index([layerId])
  @@map("cost_layer_consumptions")
}

// CACHE เท่านั้น — source of truth คือ SUM(stock_movements) ตรวจด้วย /inventory/reconcile
model StockBalance {
  product     Product   @relation(fields: [productId], references: [id])
  productId   String    @map("product_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  warehouseId String    @map("warehouse_id")
  qtyOnHand   Decimal   @default(0) @map("qty_on_hand") @db.Decimal(18, 3)
  avgCost     Decimal   @default(0) @map("avg_cost") @db.Decimal(18, 4)
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@id([productId, warehouseId])
  @@map("stock_balances")
}

// ---------- เอกสารซื้อ-ขาย (document flow + state machine) ----------

// เลขรันเอกสารแยกตามประเภท+งวด: QT-2026-08-0001
model DocumentCounter {
  docType String @map("doc_type")
  period  String // YYYY-MM
  lastNo  Int    @default(0) @map("last_no")

  @@id([docType, period])
  @@map("document_counters")
}

enum QuotationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  CONVERTED
  EXPIRED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_DELIVERED
  DELIVERED
  CLOSED
  CANCELLED
}

enum DeliveryStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  TRANSFER
  CHEQUE
  CREDIT_CARD
}

model Quotation {
  id          String          @id @default(uuid())
  docNo       String          @unique @map("doc_no")
  status      QuotationStatus @default(DRAFT)
  partner     Partner         @relation(fields: [partnerId], references: [id])
  partnerId   String          @map("partner_id")
  docDate     DateTime        @default(now()) @map("doc_date")
  validUntil  DateTime?       @map("valid_until")
  remark      String?
  vatRate     Decimal         @default(7) @map("vat_rate") @db.Decimal(5, 2)
  subtotal    Decimal         @default(0) @db.Decimal(18, 2)
  vatAmount   Decimal         @default(0) @map("vat_amount") @db.Decimal(18, 2)
  totalAmount Decimal         @default(0) @map("total_amount") @db.Decimal(18, 2)
  lines       QuotationLine[]
  salesOrders SalesOrder[]
  createdBy   String          @map("created_by")
  approvedBy  String?         @map("approved_by")
  approvedAt  DateTime?       @map("approved_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([partnerId, docDate])
  @@index([status])
  @@map("quotations")
}

model QuotationLine {
  id            String          @id @default(uuid())
  quotation     Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quotationId   String          @map("quotation_id")
  lineNo        Int             @map("line_no")
  product       Product         @relation(fields: [productId], references: [id])
  productId     String          @map("product_id")
  // หน่วยที่ขาย (null = หน่วยฐาน) — ขายเป็นมัด/ม้วนได้
  productUnit   ProductUnit?    @relation(fields: [productUnitId], references: [id])
  productUnitId String?         @map("product_unit_id")
  qty           Decimal         @db.Decimal(18, 3)
  /// จำนวนในหน่วยฐาน = qty × conversion_factor (ใช้ตัดสต๊อก)
  baseQty       Decimal         @map("base_qty") @db.Decimal(18, 3)
  unitPrice     Decimal         @map("unit_price") @db.Decimal(18, 2)
  discount      Decimal         @default(0) @db.Decimal(18, 2)
  lineTotal     Decimal         @map("line_total") @db.Decimal(18, 2)
  soLines       SalesOrderLine[]

  @@map("quotation_lines")
}

model SalesOrder {
  id           String           @id @default(uuid())
  docNo        String           @unique @map("doc_no")
  status       SalesOrderStatus @default(DRAFT)
  partner      Partner          @relation(fields: [partnerId], references: [id])
  partnerId    String           @map("partner_id")
  quotation    Quotation?       @relation(fields: [quotationId], references: [id])
  quotationId  String?          @map("quotation_id")
  warehouse    Warehouse        @relation(fields: [warehouseId], references: [id])
  warehouseId  String           @map("warehouse_id")
  docDate      DateTime         @default(now()) @map("doc_date")
  deliveryDate DateTime?        @map("delivery_date")
  remark       String?
  vatRate      Decimal          @default(7) @map("vat_rate") @db.Decimal(5, 2)
  subtotal     Decimal          @default(0) @db.Decimal(18, 2)
  vatAmount    Decimal          @default(0) @map("vat_amount") @db.Decimal(18, 2)
  totalAmount  Decimal          @default(0) @map("total_amount") @db.Decimal(18, 2)
  lines        SalesOrderLine[]
  deliveries   DeliveryOrder[]
  invoices     Invoice[]
  createdBy    String           @map("created_by")
  confirmedBy  String?          @map("confirmed_by")
  confirmedAt  DateTime?        @map("confirmed_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([partnerId, docDate])
  @@index([status])
  @@map("sales_orders")
}

model SalesOrderLine {
  id            String              @id @default(uuid())
  salesOrder    SalesOrder          @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  salesOrderId  String              @map("sales_order_id")
  lineNo        Int                 @map("line_no")
  product       Product             @relation(fields: [productId], references: [id])
  productId     String              @map("product_id")
  productUnit   ProductUnit?        @relation(fields: [productUnitId], references: [id])
  productUnitId String?             @map("product_unit_id")
  qty           Decimal             @db.Decimal(18, 3)
  baseQty       Decimal             @map("base_qty") @db.Decimal(18, 3)
  unitPrice     Decimal             @map("unit_price") @db.Decimal(18, 2)
  discount      Decimal             @default(0) @db.Decimal(18, 2)
  lineTotal     Decimal             @map("line_total") @db.Decimal(18, 2)
  /// ยอดสะสมที่ส่งของแล้ว/วางบิลแล้ว (หน่วยฐาน) — ใช้คุมการส่งบางส่วน
  qtyDelivered  Decimal             @default(0) @map("qty_delivered") @db.Decimal(18, 3)
  qtyInvoiced   Decimal             @default(0) @map("qty_invoiced") @db.Decimal(18, 3)
  /// ลูกโซ่เอกสาร: ชี้กลับไปที่บรรทัดของใบเสนอราคาต้นทาง
  sourceLine    QuotationLine?      @relation(fields: [sourceLineId], references: [id])
  sourceLineId  String?             @map("source_line_id")
  deliveryLines DeliveryOrderLine[]
  invoiceLines  InvoiceLine[]

  @@map("sales_order_lines")
}

model DeliveryOrder {
  id           String              @id @default(uuid())
  docNo        String              @unique @map("doc_no")
  status       DeliveryStatus      @default(DRAFT)
  partner      Partner             @relation(fields: [partnerId], references: [id])
  partnerId    String              @map("partner_id")
  salesOrder   SalesOrder          @relation(fields: [salesOrderId], references: [id])
  salesOrderId String              @map("sales_order_id")
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id])
  warehouseId  String              @map("warehouse_id")
  docDate      DateTime            @default(now()) @map("doc_date")
  remark       String?
  lines        DeliveryOrderLine[]
  invoiceLines InvoiceLine[]
  createdBy    String              @map("created_by")
  confirmedBy  String?             @map("confirmed_by")
  confirmedAt  DateTime?           @map("confirmed_at")
  cancelledBy  String?             @map("cancelled_by")
  cancelledAt  DateTime?           @map("cancelled_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@index([salesOrderId])
  @@index([status])
  @@map("delivery_orders")
}

model DeliveryOrderLine {
  id              String         @id @default(uuid())
  deliveryOrder   DeliveryOrder  @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  deliveryOrderId String         @map("delivery_order_id")
  lineNo          Int            @map("line_no")
  product         Product        @relation(fields: [productId], references: [id])
  productId       String         @map("product_id")
  productUnit     ProductUnit?   @relation(fields: [productUnitId], references: [id])
  productUnitId   String?        @map("product_unit_id")
  qty             Decimal        @db.Decimal(18, 3)
  baseQty         Decimal        @map("base_qty") @db.Decimal(18, 3)
  unitPrice       Decimal        @map("unit_price") @db.Decimal(18, 2)
  discount        Decimal        @default(0) @db.Decimal(18, 2)
  lineTotal       Decimal        @map("line_total") @db.Decimal(18, 2)
  /// สินค้า SERIAL: เครื่องที่จะส่ง / สินค้า LOT: ล็อตที่จะจ่าย
  serials         String[]
  lot             Lot?           @relation(fields: [lotId], references: [id])
  lotId           String?        @map("lot_id")
  /// movement ที่เกิดตอน confirm — ใช้กลับรายการตอนยกเลิกใบส่งของ
  movementId      String?        @map("movement_id")
  sourceLine      SalesOrderLine @relation(fields: [sourceLineId], references: [id])
  sourceLineId    String         @map("source_line_id")
  invoiceLines    InvoiceLine[]

  @@map("delivery_order_lines")
}

model Invoice {
  id           String        @id @default(uuid())
  docNo        String        @unique @map("doc_no")
  status       InvoiceStatus @default(DRAFT)
  partner      Partner       @relation(fields: [partnerId], references: [id])
  partnerId    String        @map("partner_id")
  salesOrder   SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  salesOrderId String?       @map("sales_order_id")
  docDate      DateTime      @default(now()) @map("doc_date")
  dueDate      DateTime      @map("due_date")
  remark       String?
  vatRate      Decimal       @default(7) @map("vat_rate") @db.Decimal(5, 2)
  subtotal     Decimal       @default(0) @db.Decimal(18, 2)
  vatAmount    Decimal       @default(0) @map("vat_amount") @db.Decimal(18, 2)
  totalAmount  Decimal       @default(0) @map("total_amount") @db.Decimal(18, 2)
  amountPaid   Decimal       @default(0) @map("amount_paid") @db.Decimal(18, 2)
  lines        InvoiceLine[]
  allocations  PaymentAllocation[]
  createdBy    String        @map("created_by")
  issuedBy     String?       @map("issued_by")
  issuedAt     DateTime?     @map("issued_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([partnerId, status])
  @@index([status, dueDate])
  @@map("invoices")
}

model InvoiceLine {
  id              String             @id @default(uuid())
  invoice         Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId       String             @map("invoice_id")
  lineNo          Int                @map("line_no")
  product         Product            @relation(fields: [productId], references: [id])
  productId       String             @map("product_id")
  productUnit     ProductUnit?       @relation(fields: [productUnitId], references: [id])
  productUnitId   String?            @map("product_unit_id")
  qty             Decimal            @db.Decimal(18, 3)
  baseQty         Decimal            @map("base_qty") @db.Decimal(18, 3)
  unitPrice       Decimal            @map("unit_price") @db.Decimal(18, 2)
  discount        Decimal            @default(0) @db.Decimal(18, 2)
  lineTotal       Decimal            @map("line_total") @db.Decimal(18, 2)
  deliveryOrder   DeliveryOrder?     @relation(fields: [deliveryOrderId], references: [id])
  deliveryOrderId String?            @map("delivery_order_id")
  sourceLine      DeliveryOrderLine? @relation(fields: [sourceLineId], references: [id])
  sourceLineId    String?            @map("source_line_id")
  soLine          SalesOrderLine?    @relation(fields: [soLineId], references: [id])
  soLineId        String?            @map("so_line_id")

  @@map("invoice_lines")
}

model Payment {
  id          String              @id @default(uuid())
  docNo       String              @unique @map("doc_no")
  partner     Partner             @relation(fields: [partnerId], references: [id])
  partnerId   String              @map("partner_id")
  paymentDate DateTime            @default(now()) @map("payment_date")
  method      PaymentMethod       @default(CASH)
  amount      Decimal             @db.Decimal(18, 2)
  reference   String?
  remark      String?
  allocations PaymentAllocation[]
  createdBy   String              @map("created_by")
  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([partnerId, paymentDate])
  @@map("payments")
}

model PaymentAllocation {
  id        String  @id @default(uuid())
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId String  @map("payment_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  invoiceId String  @map("invoice_id")
  amount    Decimal @db.Decimal(18, 2)

  @@index([invoiceId])
  @@map("payment_allocations")
}

// ---------- เอกสารฝั่งซื้อ (PO → GR) ----------

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum GoodsReceiptStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  docNo        String              @unique @map("doc_no")
  status       PurchaseOrderStatus @default(DRAFT)
  /// ซัพพลายเออร์
  partner      Partner             @relation(fields: [partnerId], references: [id])
  partnerId    String              @map("partner_id")
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id])
  warehouseId  String              @map("warehouse_id")
  docDate      DateTime            @default(now()) @map("doc_date")
  expectedDate DateTime?           @map("expected_date")
  remark       String?
  vatRate      Decimal             @default(7) @map("vat_rate") @db.Decimal(5, 2)
  subtotal     Decimal             @default(0) @db.Decimal(18, 2)
  vatAmount    Decimal             @default(0) @map("vat_amount") @db.Decimal(18, 2)
  totalAmount  Decimal             @default(0) @map("total_amount") @db.Decimal(18, 2)
  lines        PurchaseOrderLine[]
  receipts     GoodsReceipt[]
  createdBy    String              @map("created_by")
  approvedBy   String?             @map("approved_by")
  approvedAt   DateTime?           @map("approved_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@index([partnerId, docDate])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String             @id @default(uuid())
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderId String             @map("purchase_order_id")
  lineNo          Int                @map("line_no")
  product         Product            @relation(fields: [productId], references: [id])
  productId       String             @map("product_id")
  productUnit     ProductUnit?       @relation(fields: [productUnitId], references: [id])
  productUnitId   String?            @map("product_unit_id")
  qty             Decimal            @db.Decimal(18, 3)
  baseQty         Decimal            @map("base_qty") @db.Decimal(18, 3)
  /// ทุนต่อหน่วยที่ซื้อ (ไม่ใช่ราคาขาย)
  unitCost        Decimal            @map("unit_cost") @db.Decimal(18, 4)
  discount        Decimal            @default(0) @db.Decimal(18, 2)
  lineTotal       Decimal            @map("line_total") @db.Decimal(18, 2)
  /// ยอดรับเข้าสะสม (หน่วยฐาน) — คุมการรับบางส่วน
  qtyReceived     Decimal            @default(0) @map("qty_received") @db.Decimal(18, 3)
  receiptLines    GoodsReceiptLine[]

  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id              String             @id @default(uuid())
  docNo           String             @unique @map("doc_no")
  status          GoodsReceiptStatus @default(DRAFT)
  partner         Partner            @relation(fields: [partnerId], references: [id])
  partnerId       String             @map("partner_id")
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId String             @map("purchase_order_id")
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id])
  warehouseId     String             @map("warehouse_id")
  docDate         DateTime           @default(now()) @map("doc_date")
  /// เลขที่ใบส่งของ/ใบกำกับของซัพพลายเออร์
  supplierRef     String?            @map("supplier_ref")
  remark          String?
  lines           GoodsReceiptLine[]
  createdBy       String             @map("created_by")
  confirmedBy     String?            @map("confirmed_by")
  confirmedAt     DateTime?          @map("confirmed_at")
  cancelledBy     String?            @map("cancelled_by")
  cancelledAt     DateTime?          @map("cancelled_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([purchaseOrderId])
  @@index([status])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id             String            @id @default(uuid())
  goodsReceipt   GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  goodsReceiptId String            @map("goods_receipt_id")
  lineNo         Int               @map("line_no")
  product        Product           @relation(fields: [productId], references: [id])
  productId      String            @map("product_id")
  productUnit    ProductUnit?      @relation(fields: [productUnitId], references: [id])
  productUnitId  String?           @map("product_unit_id")
  qty            Decimal           @db.Decimal(18, 3)
  baseQty        Decimal           @map("base_qty") @db.Decimal(18, 3)
  unitCost       Decimal           @map("unit_cost") @db.Decimal(18, 4)
  lineTotal      Decimal           @map("line_total") @db.Decimal(18, 2)
  /// สินค้า SERIAL: เครื่องที่รับเข้า / สินค้า LOT: ล็อตใหม่ที่รับ
  serials        String[]
  lotNo          String?           @map("lot_no")
  expiryDate     DateTime?         @map("expiry_date")
  /// movement ที่เกิดตอน confirm — ใช้กลับรายการตอนยกเลิกใบรับของ
  movementId     String?           @map("movement_id")
  sourceLine     PurchaseOrderLine @relation(fields: [sourceLineId], references: [id])
  sourceLineId   String            @map("source_line_id")

  @@map("goods_receipt_lines")
}

// ---------- Audit trail ----------

/// บันทึกทุกการเปลี่ยนแปลงข้อมูล (ใคร ทำอะไร กับอะไร เมื่อไหร่ จากที่ไหน)
/// append-only เหมือน ledger — ไม่มี endpoint แก้/ลบ
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  userEmail  String?  @map("user_email")
  userRole   String?  @map("user_role")
  /// เช่น quotations.approve, deliveries.confirm, inventory.adjustments
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  method     String
  path       String
  statusCode Int      @map("status_code")
  /// body ที่ตัดข้อมูลอ่อนไหวออกแล้ว
  payload    Json?
  ip         String?
  durationMs Int      @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") // sha256 ของ token — ไม่เก็บ token ดิบ
  familyId  String    @map("family_id") // ใช้ตรวจ reuse: token เก่าถูกใช้ซ้ำ → revoke ทั้ง family
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}
