NODE_ENV=development
PORT=3009

DATABASE_URL=postgresql://store:storepass_dev@localhost:5433/storedb?schema=public

# อย่างน้อย 32 ตัวอักษร — สุ่มเองด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ห้ามใช้ค่าที่ก๊อปมาจากที่อื่น ใครก็ตามที่รู้ค่านี้ปลอม token เข้าระบบได้
JWT_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# คั่นหลาย origin ด้วย comma
CORS_ORIGINS=http://localhost:3001

SEED_ADMIN_EMAIL=admin@store.local
SEED_ADMIN_PASSWORD=

# Cloudinary (รูปสินค้า) — ไม่ใส่ก็รันได้ แต่ endpoint ขอลายเซ็นอัปโหลดจะปิด
# หา API Key/Secret ได้ที่ console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ปิด cron เวลารันหลาย instance (ไม่งั้นงานประจำจะทำซ้ำ)
CRON_ENABLED=true
